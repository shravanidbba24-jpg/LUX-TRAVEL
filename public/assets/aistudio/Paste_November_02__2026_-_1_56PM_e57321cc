    <p>Your dream trip is booked! Our team will contact you shortly.</p>
    <div class="booking-id">
      <span>Booking ID</span>
      <strong id="bookingId">IT-000000</strong>
    </div>
    <div class="modal-details" id="modalDetails"></div>
    <button class="modal-close" onclick="closeModal()">Done ✓</button>
  </div>
</div>

<script>
  let selectedPkg = null;
  let selectedPrice = 0;

  document.getElementById('travelDate').min = new Date().toISOString().split('T')[0];

  function selectPackage(card, name, price) {
    document.querySelectorAll('.card, .day-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    selectedPkg = name;
    selectedPrice = price;

    document.getElementById('pkgDisplay').classList.add('show');
    document.getElementById('pkgName').textContent = name + ' — ₹' + price.toLocaleString() + '/person';

    const sel = document.getElementById('pkgSelect');
    for (let o of sel.options) {
      if (o.value.startsWith(name + '|')) { sel.value = o.value; break; }
    }

    calcTotal();
    setTimeout(() => document.getElementById('booking').scrollIntoView({ behavior: 'smooth' }), 300);
  }

  function selectFromDropdown() {
    const val = document.getElementById('pkgSelect').value;
    if (!val) return;
    const [name, price] = val.split('|');
    selectedPkg = name;
    selectedPrice = parseInt(price);
    document.getElementById('pkgDisplay').classList.add('show');
    document.getElementById('pkgName').textContent = name + ' — ₹' + parseInt(price).toLocaleString() + '/person';
    calcTotal();
  }

  function calcTotal() {
    const persons = parseInt(document.getElementById('adults').value) || 1;
    const total = selectedPrice * persons;
    document.getElementById('totalAmt').textContent = total ? '₹' + total.toLocaleString() : '₹0';
  }

  function confirmBooking() {
    const name = document.getElementById('fullName').value.trim();
    const email = document.getElementById('email').value.trim();
    const phone = document.getElementById('phone').value.trim();
    const date = document.getElementById('travelDate').value;
    const persons = document.getElementById('adults').value;

    if (!name) return alert('⚠️ Please enter your full name!');
    if (!email || !email.includes('@')) return alert('⚠️ Please enter a valid email!');
    if (!phone || phone.length < 10) return alert('⚠️ Please enter a valid phone number!');
    if (!date) return alert('⚠️ Please select a travel date!');
    if (!selectedPkg) return alert('⚠️ Please select a travel package!');

    const bookingId = 'IT-' + Math.floor(100000 + Math.random() * 900000);
    const total = (selectedPrice * parseInt(persons)).toLocaleString();
    const formattedDate = new Date(date).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

    document.getElementById('bookingId').textContent = bookingId;
    document.getElementById('modalDetails').innerHTML = `
      <p>👤 <strong>Name:</strong> ${name}</p>
      <p>📧 <strong>Email:</strong> ${email}</p>
      <p>📦 <strong>Package:</strong> ${selectedPkg}</p>
      <p>📅 <strong>Travel Date:</strong> ${formattedDate}</p>
      <p>👥 <strong>Persons:</strong> ${persons}</p>
      <p>💰 <strong>Total Amount:</strong> ₹${total}</p>
    `;
    document.getElementById('modal').classList.add('show');
  }

  function closeModal() {
    document.getElementById('modal').classList.remove('show');
    document.getElementById('fullName').value = '';
    document.getElementById('email').value = '';
    document.getElementById('phone').value = '';
    document.getElementById('travelDate').value = '';
    document.getElementById('adults').value = '1';
    document.getElementById('pkgSelect').value = '';
    document.getElementById('pkgDisplay').classList.remove('show');
    document.querySelectorAll('.card, .day-card').forEach(c => c.classList.remove('selected'));
    selectedPkg = null; selectedPrice = 0;
    document.getElementById('totalAmt').textContent = '₹0';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
</script>
