<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Infinity Travels — Your Journey Begins Here</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #C8922A;
    --gold-light: #E8B94F;
    --terra: #C4613A;
    --deep: #1A1208;
    --cream: #FBF7EE;
    --sand: #F5EFE0;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--deep); }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 3rem;
    background: rgba(26,18,8,0.95); backdrop-filter: blur(10px);
  }
  .logo { font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--gold-light); }
  .logo span { color: var(--terra); }
  nav ul { display: flex; gap: 2rem; list-style: none; }
  nav ul a { color: #F5EFE0; text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
  nav ul a:hover { color: var(--gold-light); }

  /* HERO */
  .hero {
    min-height: 100vh;
    background: linear-gradient(rgba(15,10,5,0.62), rgba(20,13,5,0.70)),
      url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=1600&auto=format&fit=crop') center/cover no-repeat;
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    text-align: center; padding: 6rem 2rem 3rem;
  }
  .hero-badge {
    background: var(--terra); color: white;
    padding: 0.4rem 1.2rem; border-radius: 30px;
    font-size: 0.75rem; font-weight: 600; letter-spacing: 2px;
    text-transform: uppercase; margin-bottom: 1.5rem;
  }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: var(--sand); line-height: 1.1; margin-bottom: 1rem;
  }
  .hero h1 span { color: var(--gold-light); }
  .hero p { color: #A89880; font-size: 1.1rem; max-width: 500px; margin-bottom: 2.5rem; line-height: 1.6; }
  .hero-btn {
    background: var(--gold); color: var(--deep);
    padding: 1rem 2.5rem; border-radius: 50px;
    font-size: 1rem; font-weight: 700; cursor: pointer;
    border: none; text-decoration: none; display: inline-block;
    transition: all 0.2s; letter-spacing: 0.5px;
  }
  .hero-btn:hover { background: var(--gold-light); transform: translateY(-2px); }

  /* SECTION COMMON */
  .packages { padding: 5rem 3rem; background: var(--cream); }
  .day-trips { padding: 5rem 3rem; background: var(--sand); }
  .section-title { text-align: center; margin-bottom: 3rem; }
  .section-title h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem; color: var(--deep); margin-bottom: 0.5rem;
  }
  .section-title p { color: #6B5B45; font-size: 1rem; }
  .section-title .section-tag {
    display: inline-block; background: var(--terra); color: white;
    padding: 0.3rem 1rem; border-radius: 30px;
    font-size: 0.72rem; font-weight: 600; letter-spacing: 2px;
    text-transform: uppercase; margin-bottom: 0.8rem;
  }

  /* CARDS */
  .cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem; max-width: 1200px; margin: 0 auto;
  }
  .card {
    background: white; border-radius: 16px;
    overflow: hidden; box-shadow: 0 4px 20px rgba(26,18,8,0.08);
    transition: transform 0.3s, box-shadow 0.3s; cursor: pointer;
    border: 2px solid transparent;
  }
  .card:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(26,18,8,0.15); }
  .card.selected { border-color: var(--gold); }
  .card-img {
    height: 160px; display: flex; align-items: center; justify-content: center;
    font-size: 3.5rem; position: relative;
  }
  .badge-days {
    position: absolute; top: 10px; right: 10px;
    background: rgba(0,0,0,0.55); color: white;
    padding: 0.3rem 0.7rem; border-radius: 20px; font-size: 0.72rem; font-weight: 600;
  }
  .card-body { padding: 1.2rem; }
  .card-body h3 { font-family: 'Playfair Display', serif; font-size: 1.15rem; margin-bottom: 0.25rem; }
  .card-body .location { color: #6B5B45; font-size: 0.82rem; margin-bottom: 0.7rem; }
  .card-features { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .feature-tag {
    background: var(--sand); color: var(--deep);
    padding: 0.2rem 0.55rem; border-radius: 20px; font-size: 0.7rem; font-weight: 500;
  }
  .card-footer { display: flex; align-items: center; justify-content: space-between; }
  .price { font-size: 1.25rem; font-weight: 700; color: var(--gold); }
  .price span { font-size: 0.72rem; color: #6B5B45; font-weight: 400; }
  .select-btn {
    background: var(--deep); color: white;
    border: none; padding: 0.5rem 1.1rem;
    border-radius: 25px; font-size: 0.82rem; font-weight: 600;
    cursor: pointer; transition: background 0.2s;
  }
  .select-btn:hover, .card.selected .select-btn { background: var(--gold); color: var(--deep); }

  /* DAY TRIP CARDS - smaller style */
  .day-cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem; max-width: 600px; margin: 0 auto;
  }
  .day-card {
    background: white; border-radius: 16px;
    overflow: hidden; box-shadow: 0 4px 20px rgba(26,18,8,0.08);
    transition: transform 0.3s, box-shadow 0.3s; cursor: pointer;
    border: 2px solid transparent;
  }
  .day-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(26,18,8,0.12); }
  .day-card.selected { border-color: var(--gold); }
  .day-card-icon { height: 160px; display: flex; align-items: center; justify-content: center; font-size: 3.5rem; position: relative; }
  .day-card-body { padding: 1.2rem; }
  .day-card-body h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; margin-bottom: 0.3rem; }
  .day-card-body .sub { color: #6B5B45; font-size: 0.82rem; margin-bottom: 0.8rem; }
  .day-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }

  /* BOOKING FORM */
  .booking-section {
    padding: 5rem 3rem;
    background: linear-gradient(135deg, #1A1208, #2D1E0A);
  }
  .booking-section .section-title h2 { color: var(--sand); }
  .booking-section .section-title p { color: #A89880; }
  .form-container {
    max-width: 650px; margin: 0 auto;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(200,146,42,0.3);
    border-radius: 20px; padding: 2.5rem;
  }
  .selected-package-display {
    background: rgba(200,146,42,0.15);
    border: 1px solid var(--gold);
    border-radius: 12px; padding: 1rem 1.5rem;
    margin-bottom: 2rem; display: none;
  }
  .selected-package-display.show { display: block; }
  .selected-package-display h4 { color: var(--gold-light); font-size: 0.8rem; letter-spacing: 1px; text-transform: uppercase; }
  .selected-package-display p { color: var(--sand); font-size: 1.1rem; font-weight: 600; margin-top: 0.2rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
  .form-group { display: flex; flex-direction: column; margin-bottom: 1rem; }
  .form-group label { color: #A89880; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 0.4rem; text-transform: uppercase; }
  .form-group input, .form-group select {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(200,146,42,0.25);
    color: var(--sand); padding: 0.85rem 1rem;
    border-radius: 10px; font-size: 0.95rem;
    font-family: 'DM Sans', sans-serif;
    transition: border-color 0.2s; outline: none;
  }
  .form-group input:focus, .form-group select:focus { border-color: var(--gold); }
  .form-group select option { background: #2D1E0A; color: var(--sand); }
  .form-group input::placeholder { color: #5A4A35; }
  .total-price {
    background: rgba(200,146,42,0.1);
    border: 1px dashed rgba(200,146,42,0.4);
    border-radius: 10px; padding: 1rem 1.5rem;
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 1.5rem;
  }
  .total-price span { color: #A89880; font-size: 0.9rem; }
  .total-price strong { color: var(--gold-light); font-size: 1.4rem; font-weight: 700; }
  .book-btn {
    width: 100%; background: var(--gold);
    color: var(--deep); border: none;
    padding: 1.1rem; border-radius: 12px;
    font-size: 1rem; font-weight: 700;
    cursor: pointer; font-family: 'DM Sans', sans-serif;
    letter-spacing: 0.5px; transition: all 0.2s;
  }
  .book-btn:hover { background: var(--gold-light); transform: translateY(-1px); }

  /* MODAL */
  .modal-overlay {
    position: fixed; inset: 0; z-index: 999;
    background: rgba(0,0,0,0.85); backdrop-filter: blur(5px);
    display: none; align-items: center; justify-content: center; padding: 2rem;
  }
  .modal-overlay.show { display: flex; }
  .modal {
    background: white; border-radius: 24px;
    padding: 3rem; text-align: center; max-width: 480px; width: 100%;
    animation: popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes popIn {
    from { transform: scale(0.7); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .modal-icon { font-size: 4rem; margin-bottom: 1rem; }
  .modal h2 { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--deep); margin-bottom: 0.5rem; }
  .modal p { color: #6B5B45; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; }
  .booking-id { background: var(--sand); border-radius: 12px; padding: 1rem; margin-bottom: 1.5rem; }
  .booking-id span { display: block; font-size: 0.75rem; color: #6B5B45; text-transform: uppercase; letter-spacing: 1px; }
  .booking-id strong { font-size: 1.3rem; color: var(--gold); font-weight: 700; letter-spacing: 3px; }
  .modal-details { text-align: left; background: var(--sand); border-radius: 12px; padding: 1rem 1.5rem; margin-bottom: 1.5rem; }
  .modal-details p { font-size: 0.88rem; color: var(--deep); padding: 0.3rem 0; border-bottom: 1px solid #E8DFD0; }
  .modal-details p:last-child { border-bottom: none; }
  .modal-details strong { color: var(--gold); }
  .modal-close {
    background: var(--deep); color: white; border: none;
    padding: 0.9rem 2.5rem; border-radius: 30px;
    font-size: 0.95rem; font-weight: 600; cursor: pointer;
    font-family: 'DM Sans', sans-serif; transition: background 0.2s;
  }
  .modal-close:hover { background: var(--gold); color: var(--deep); }

  /* FOOTER */
  footer {
    background: var(--deep); color: #5A4A35;
    text-align: center; padding: 1.5rem; font-size: 0.85rem;
  }
  footer span { color: var(--gold); }

  /* CARD COLORS */
  .c-paris    { background: linear-gradient(135deg, #2C3E8C, #6A5ACD); }
  .c-maldives { background: linear-gradient(135deg, #00B4D8, #48CAE4); }
  .c-dubai    { background: linear-gradient(135deg, #D4A017, #F4C542); }
  .c-kerala   { background: linear-gradient(135deg, #43e97b, #38f9d7); }
  .c-goa      { background: linear-gradient(135deg, #667eea, #764ba2); }
  .c-hyd      { background: linear-gradient(135deg, #f7971e, #ffd200); }
  .c-mumbai   { background: linear-gradient(135deg, #fc5c7d, #6a3093); }
  .c-pune     { background: linear-gradient(135deg, #11998e, #38ef7d); }
  .c-delhi    { background: linear-gradient(135deg, #ee0979, #ff6a00); }
  .c-tirupati { background: linear-gradient(135deg, #f9a825, #fdd835); }
  .c-ladakh   { background: linear-gradient(135deg, #5C6BC0, #B39DDB); }
  .c-manali   { background: linear-gradient(135deg, #4facfe, #00f2fe); }
  .c-rajasthan{ background: linear-gradient(135deg, #fa709a, #fee140); }
  .c-bangkok  { background: linear-gradient(135deg, #a18cd1, #fbc2eb); }

  @media (max-width: 600px) {
    nav { padding: 1rem 1.5rem; }
    nav ul { display: none; }
    .packages, .day-trips, .booking-section { padding: 3rem 1rem; }
    .form-row { grid-template-columns: 1fr; }
    .form-container { padding: 1.5rem; }
    .day-card { flex-direction: column; text-align: center; }
  }
</style>
</head>
